@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<div class="container mt-5" style="max-width:420px">
    <div class="card shadow">
        <div class="card-body p-4">
            <h4 class="mb-4 text-center">GEC Manager — Login</h4>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }
            <div class="mb-3">
                <label class="form-label">E-mail</label>
                <input class="form-control" type="email" @bind="_email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Senha</label>
                <input class="form-control" type="password" @bind="_password" />
            </div>
            <button class="btn btn-primary w-100" @onclick="HandleLogin" disabled="@_loading">
                @(_loading ? "Entrando..." : "Entrar")
            </button>
            <hr />
            <p class="text-center mb-0">Não tem conta? <a href="/register">Cadastre-se</a></p>
        </div>
    </div>
</div>

@code {
    string _email = "", _password = "", _error = "";
    bool _loading;

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.TryRestoreTokenAsync())
            Nav.NavigateTo("/");
    }

    async Task HandleLogin()
    {
        _error = "";
        _loading = true;
        var ok = await Auth.LoginAsync(_email, _password);
        _loading = false;
        if (ok) Nav.NavigateTo("/");
        else _error = "E-mail ou senha inválidos.";
    }
}
